# Local synthetic demo; leave all secrets blank in source control.
AI_PROVIDER="mock"
# Set to a model enabled for the project's Gemini API tier when AI_PROVIDER="gemini".
AI_MODEL=""
# Optional; empty inherits AI_MODEL.
AI_CONVERSATION_MODEL=""
# Optional; empty inherits AI_MODEL.
AI_WEB_MODEL=""
AI_WEB_SEARCH="false"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
SUPPORT_STORAGE="memory-demo"
SUPPORT_ACCESS_MODE="public-demo"
# Optional local stable requester links; generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required in Production. Never reuse an Identity/session key.
SUPPORT_TRACKING_SECRET=""
SUPPORT_VERIFY_FAULTS="true"
MONGODB_URI=""
MONGODB_DB="nsclub_support_desk"
# Identity can share the configured database using separate collections; blank URI inherits MONGODB_URI.
# Requires Mongo transactions (replica set); no memory/CSV account fallback.
IDENTITY_MONGODB_URI=""
IDENTITY_MONGODB_DB="nsclub_support_desk"
# ID/password identity. Configure private values only in the local environment
# or Vercel Production secrets; never commit passwords, mail credentials or tokens.
IDENTITY_ADMIN_ID=""
# Use a unique administrator password of at least 12 characters.
IDENTITY_ADMIN_PASSWORD=""
IDENTITY_ADMIN_EMAIL=""
# Leave disabled until the fixed account email templates have been reviewed.
IDENTITY_EMAIL_ENABLED="false"
# SMTP account used to notify the owner and deliver issued demo credentials.
# For Gmail SMTP, use an App Password; never use your normal Google password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
APP_BASE_URL="http://localhost:3000"
ENVIRONMENT="development"
