# Local synthetic demo; leave all secrets blank in source control.
AI_PROVIDER="mock"
# Set to a model enabled for the project's Gemini API tier when AI_PROVIDER="gemini".
AI_MODEL=""
# Optional; empty inherits AI_MODEL.
AI_CONVERSATION_MODEL=""
# Optional; empty inherits AI_MODEL.
AI_WEB_MODEL=""
AI_WEB_SEARCH="false"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
SUPPORT_STORAGE="memory-demo"
SUPPORT_ACCESS_MODE="public-demo"
SUPPORT_VERIFY_FAULTS="true"
MONGODB_URI=""
MONGODB_DB="nsclub_support_desk"
# Identity can share the configured database using separate collections; blank URI inherits MONGODB_URI.
# Requires Mongo transactions (replica set); no memory/CSV account fallback.
IDENTITY_MONGODB_URI=""
IDENTITY_MONGODB_DB="nsclub_support_desk"
ENVIRONMENT="development"
